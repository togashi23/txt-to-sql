{
  "name": "txt-to-sql",
  "version": "1.0.0",
  "description": "ExcelやスプレッドシートからコピーしたTSVをそのまま貼り付けて、INSERT文を手早く用意するためのWebアプリ。",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy",
    "watch": "npm run copy && tsc --watch",
    "copy": "node -e \"require('fs').cpSync('src', 'dist', { recursive: true, filter: (f) => !f.endsWith('.ts') })\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/togashi23/txt-to-sql.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/togashi23/txt-to-sql/issues"
  },
  "homepage": "https://github.com/togashi23/txt-to-sql#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/requirejs": "^2.1.37",
    "monaco-editor": "^0.52.2",
    "typescript": "^7.0.2"
  }
}
