{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "es2022",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    // AMDローダー（require）の型定義
    "types": ["requirejs"]
  },
  // Monacoの型定義はグローバル（monacoネームスペース）として読み込む
  "include": ["src", "node_modules/monaco-editor/monaco.d.ts"]
}
